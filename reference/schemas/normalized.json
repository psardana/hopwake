{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hopwake.example/reference/normalized.json",
  "title": "Normalised reading, telemetry/v2",
  "type": "object",
  "required": ["schema", "device", "site", "seq", "observed_at", "temperature_k", "pressure_pa", "vibration_mm_s"],
  "properties": {
    "schema": {"const": "telemetry/v2"},
    "device": {"type": "string"},
    "site": {"type": "string"},
    "seq": {"type": "integer", "minimum": 0},
    "observed_at": {"type": "string", "format": "date-time"},
    "temperature_k": {"type": "number", "minimum": 200, "maximum": 430, "x-unit": "K"},
    "pressure_pa": {"type": "integer", "minimum": 0, "x-unit": "Pa"},
    "vibration_mm_s": {"type": "number", "minimum": 0, "x-unit": "mm/s"}
  }
}
